<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>NDILibDotNetAdvanced</PackageId>
    <Title>.NET Wrapper for the NDI Basic and Advanced SDKs</Title>
    <Authors>Tractus Events</Authors>
    <VersionPrefix>2026.11.18.2</VersionPrefix>
    <Description>Thin managed interop wrapper for the NDI Basic and Advanced SDK libraries on Windows, macOS, and Linux. Intended for developers familiar with the native NDI SDK. Supersedes NDILibDotNetCoreBase.</Description>
    <PackageProjectUrl>https://github.com/tractusevents/NdiLibDotNetAdvanced</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tractusevents/NdiLibDotNetAdvanced</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ndi;network-device-interface;video;interop</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>NDI 6.4 interop, File recorder and player, complete SDK enum values, corrected audio and sender layouts, and allocation-free finder snapshot reads. See the README for source and binary compatibility changes.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <None Update="logo.png" Pack="true" PackagePath="\" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Update="LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
